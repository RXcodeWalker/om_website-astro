{
  "$ref": "#/definitions/writing",
  "definitions": {
    "writing": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "integer",
                "format": "unix-time"
              }
            ]
          },
          "excerpt": {
            "type": "string",
            "minLength": 60,
            "maxLength": 240
          },
          "why": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "title",
          "url",
          "date",
          "excerpt"
        ],
        "additionalProperties": false
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}