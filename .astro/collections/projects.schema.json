{
  "$ref": "#/definitions/projects",
  "definitions": {
    "projects": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "maxLength": 90
        },
        "summary": {
          "type": "string",
          "minLength": 80,
          "maxLength": 320
        },
        "kicker": {
          "type": "string",
          "maxLength": 40
        },
        "category": {
          "type": "string",
          "enum": [
            "web",
            "ai",
            "hardware",
            "tool"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "shipped",
            "in-progress",
            "experiment",
            "archived"
          ]
        },
        "year": {
          "type": "integer",
          "minimum": 2020,
          "maximum": 2100
        },
        "timeframe": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "default": "Designer & developer"
        },
        "collaborators": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "order": {
          "type": "integer"
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "thumbnail": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "type": "string",
              "minLength": 4
            }
          },
          "required": [
            "src",
            "alt"
          ],
          "additionalProperties": false
        },
        "hero": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "type": "string",
              "minLength": 4
            }
          },
          "required": [
            "src",
            "alt"
          ],
          "additionalProperties": false
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          },
          "maxItems": 4,
          "default": []
        },
        "journey": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "integer",
                    "format": "unix-time"
                  }
                ]
              },
              "end": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "integer",
                    "format": "unix-time"
                  }
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "date",
              "title"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "specs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "format": "uri"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "repo",
                  "live",
                  "demo",
                  "writeup",
                  "video",
                  "download",
                  "profile",
                  "certificate"
                ],
                "default": "live"
              }
            },
            "required": [
              "label",
              "href"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "linksNote": {
          "type": "string"
        },
        "achievement": {
          "type": "string"
        },
        "relatedPost": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "title",
            "url"
          ],
          "additionalProperties": false
        },
        "description": {
          "type": "string",
          "maxLength": 160
        }
      },
      "required": [
        "title",
        "outcome",
        "summary",
        "category",
        "status",
        "year",
        "stack",
        "order",
        "thumbnail"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}