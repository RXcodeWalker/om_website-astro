---
import SkipLink from '../components/primitives/SkipLink.astro';
import SiteHeader from '../components/chrome/SiteHeader.astro';
import SiteFooter from '../components/chrome/SiteFooter.astro';
import Meta from '../components/seo/Meta.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: 'Person' | 'BreadcrumbList' | 'CreativeWork';
  breadcrumbs?: { name: string; item: string }[];
  creativeWork?: {
    name: string;
    description: string;
    url: string;
    datePublished?: string;
  };
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType,
  noindex,
  jsonLd = 'Person',
  breadcrumbs,
  creativeWork,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-accent="ink">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    {/*
      Emitted before the init script so there is exactly one element to
      update and no dead lookup. window.__theme is the only mechanism that
      writes theme, accent, or theme-color anywhere in the codebase.
    */}
    <meta name="theme-color" content="#fbfaf8" />

    <script is:inline>
      (() => {
        const COLORS = { light: '#fbfaf8', dark: '#100f0e' };
        const root = document.documentElement;

        const apply = (theme, accent) => {
          if (theme === 'dark') {
            root.setAttribute('data-theme', 'dark');
          } else {
            root.removeAttribute('data-theme');
          }
          root.setAttribute('data-accent', accent);
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', COLORS[theme] || COLORS.light);
        };

        window.__theme = {
          get theme() {
            return root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
          },
          get accent() {
            return root.getAttribute('data-accent') || 'ink';
          },
          set(theme, accent) {
            const next = theme === 'dark' ? 'dark' : 'light';
            const nextAccent = accent || window.__theme.accent;
            try {
              localStorage.setItem('theme', next);
              localStorage.setItem('accent', nextAccent);
            } catch {
              /* storage unavailable — apply for this page only */
            }
            apply(next, nextAccent);
          },
        };

        root.classList.add('js');

        let stored = null;
        let storedAccent = null;
        try {
          stored = localStorage.getItem('theme');
          storedAccent = localStorage.getItem('accent');
        } catch {
          /* storage unavailable */
        }

        const prefersDark =
          window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        apply(stored || (prefersDark ? 'dark' : 'light'), storedAccent || 'ink');
      })();
    </script>

    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/newsreader-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <Meta {title} {description} {canonical} {ogImage} {ogType} {noindex} />
    <JsonLd type={jsonLd} breadcrumbs={breadcrumbs} creativeWork={creativeWork} />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <SiteHeader currentPath={Astro.url.pathname} />
    <slot />
    <SiteFooter />

    <script>
      // Entrance reveal. Content is visible by default; this only adds the
      // animated state when motion is welcome.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const targets = document.querySelectorAll('.reveal');
        if (targets.length > 0) {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            },
            { threshold: 0.1, rootMargin: '0px 0px -40px 0px' },
          );
          targets.forEach((target) => observer.observe(target));
        }
      }
    </script>
  </body>
</html>
