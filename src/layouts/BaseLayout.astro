---
import SkipLink from '../components/primitives/SkipLink.astro';
import SiteHeader from '../components/chrome/SiteHeader.astro';
import SiteFooter from '../components/chrome/SiteFooter.astro';
import Meta from '../components/seo/Meta.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: 'Person' | 'BreadcrumbList' | 'CreativeWork';
  breadcrumbs?: { name: string; item: string }[];
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType,
  noindex,
  jsonLd = 'Person',
  breadcrumbs,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-accent="ink">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        const theme = localStorage.getItem('theme');
        const accent = localStorage.getItem('accent') || 'ink';
        if (theme === 'dark') root.setAttribute('data-theme', 'dark');
        root.setAttribute('data-accent', accent);
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.setAttribute(
            'content',
            theme === 'dark' ? '#100f0e' : '#fbfaf8',
          );
        }
      })();
    </script>

    <Meta {title} {description} {canonical} {ogImage} {ogType} {noindex} />
    <JsonLd type={jsonLd} breadcrumbs={breadcrumbs} />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <SiteHeader currentPath={Astro.url.pathname} />
    <slot />
    <SiteFooter />

    <script is:inline src="/js/scroll.js"></script>
  </body>
</html>
