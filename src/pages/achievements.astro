---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/patterns/PageIntro.astro';
import AchievementItem from '../components/patterns/AchievementItem.astro';
import EmptyState from '../components/patterns/EmptyState.astro';
import { site } from '../config/site';
import type { Achievement } from '../schemas/achievement';

const entries = await getCollection('achievements');
const achievements = entries
  .map((entry) => entry.data as Achievement)
  .sort((a, b) => b.date.getTime() - a.date.getTime());

// A highlights band that repeats the entire inventory is noise, not curation.
const flagged = achievements.filter((item) => item.highlight);
const highlights = flagged.length < achievements.length ? flagged.slice(0, 5) : [];

const DOMAIN_LABELS: Record<Achievement['domain'], string> = {
  academics: 'Academics',
  music: 'Music',
  sport: 'Sport',
  leadership: 'Leadership',
  building: 'Building',
};

// Domains are group headings, never chips.
const groups = (Object.keys(DOMAIN_LABELS) as Achievement['domain'][])
  .map((domain) => ({
    domain,
    label: DOMAIN_LABELS[domain],
    items: achievements.filter((item) => item.domain === domain),
  }))
  .filter((group) => group.items.length > 0);
---

<BaseLayout
  title="Achievements"
  description="Awards, grades and selections earned by Om Jhamvar, each with its issuing body and why it is difficult."
  jsonLd="BreadcrumbList"
  breadcrumbs={[
    { name: 'Home', item: site.url },
    { name: 'Achievements', item: `${site.url}/achievements` },
  ]}
>
  <main id="main">
    <div class="container">
      <PageIntro
        kicker="Milestones"
        title="Achievements"
        lede="Every entry names its issuing body and explains why it is hard. Anything without both does not belong on this page."
      />

      {
        achievements.length === 0 ? (
          <EmptyState title="Inventory in progress">
            <p>
              The achievement inventory is being assembled. Each entry needs an awarding body, a
              date and a note explaining the standard it represents.
            </p>
          </EmptyState>
        ) : (
          <>
            {highlights.length > 0 && (
              <section class="group" aria-labelledby="highlights">
                <h2 id="highlights" class="group__heading">
                  Selected highlights
                </h2>
                {highlights.map((achievement) => (
                  <AchievementItem achievement={achievement} />
                ))}
              </section>
            )}

            {groups.map((group) => (
              <section class="group" aria-labelledby={`group-${group.domain}`}>
                <h2 id={`group-${group.domain}`} class="group__heading">
                  {group.label}
                </h2>
                {group.items.map((achievement) => (
                  <AchievementItem achievement={achievement} />
                ))}
              </section>
            ))}
          </>
        )
      }
    </div>
  </main>
</BaseLayout>

<style>
  .group {
    margin-top: var(--space-8);
  }

  .group__heading {
    margin: 0 0 var(--space-2);
    font-size: var(--step-3);
  }
</style>
