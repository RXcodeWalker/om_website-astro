---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/patterns/PageIntro.astro';
import AchievementItem from '../components/patterns/AchievementItem.astro';
import EmptyState from '../components/patterns/EmptyState.astro';
import { site } from '../config/site';
import { achievementGroups, relatedProjectHref } from '../utils/achievements';
import { publishedProjects } from '../utils/projects';

const publishedIds = publishedProjects(await getCollection('projects')).map((entry) => entry.id);
const entries = await getCollection('achievements');
const achievements = entries.map((entry) => entry.data);
const groups = achievementGroups(achievements);
---

<BaseLayout
  title="Achievements"
  description="Awards, grades and selections earned by Om Jhamvar, each with its issuing body and why it is difficult."
  jsonLd="BreadcrumbList"
  breadcrumbs={[
    { name: 'Home', item: site.url },
    { name: 'Achievements', item: `${site.url}/achievements` },
  ]}
>
  <main id="main">
    <div class="container">
      <PageIntro
        kicker="Evidence"
        title="Achievements"
        lede="A short list of things that were awarded, not claimed. Each one names who issued it and what the standard actually is."
      />

      {
        achievements.length === 0 ? (
          <EmptyState title="Inventory in progress">
            <p>
              The achievement inventory is being assembled. Each entry needs an awarding body, a
              date and a note explaining the standard it represents.
            </p>
          </EmptyState>
        ) : (
          groups.map((group) => (
            <section class="group" aria-labelledby={`group-${group.domain}`}>
              <h2 id={`group-${group.domain}`} class="group__heading">
                {group.label}
              </h2>
              {group.items.map((achievement) => (
                <AchievementItem
                  achievement={achievement}
                  variant={achievement.highlight ? 'featured' : 'row'}
                  relatedHref={relatedProjectHref(achievement.project, publishedIds)}
                />
              ))}
            </section>
          ))
        )
      }
    </div>
  </main>
</BaseLayout>

<style>
  .group {
    margin-top: var(--space-8);
  }

  .group__heading {
    margin: 0 0 var(--space-2);
    font-size: var(--step-3);
  }

  /* Featured weight is page-specific so homepage rows do not ship it. */
  .group :global(.achievement--featured) {
    padding-block: var(--space-7);
  }

  .group :global(.achievement--featured .achievement__title) {
    font-size: var(--step-3);
  }

  .group :global(.achievement--featured .achievement__significance) {
    font-size: var(--step-1);
    line-height: var(--leading-prose);
  }
</style>
