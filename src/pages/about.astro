---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/patterns/PageIntro.astro';
import Section from '../components/primitives/Section.astro';
import Button from '../components/primitives/Button.astro';
import { site } from '../config/site';

const interests = [
  {
    title: 'Building',
    detail:
      'Web development and software engineering, mostly learned by shipping things and then finding out what breaks.',
  },
  {
    title: 'Guitar',
    detail:
      'LCM Grade 8 with High Distinction, now working towards the diploma. Rock repertoire and live performance.',
  },
  {
    title: 'Sport',
    detail:
      'Football, Formula 1, tennis, cricket and the NFL — read as systems: tactics, decisions under pressure, patterns over a season.',
  },
  {
    title: 'Writing',
    detail:
      'The forcing function. If I cannot explain what I built and why it works, I did not understand it.',
  },
];
---

<BaseLayout
  title="About"
  description="Om Jhamvar — school student, builder, guitarist. How I work and what I am trying to do."
  jsonLd="BreadcrumbList"
  breadcrumbs={[
    { name: 'Home', item: site.url },
    { name: 'About', item: `${site.url}/about` },
  ]}
>
  <main id="main">
    <div class="container">
      <PageIntro
        kicker="The story"
        title="About me"
        lede="I am Om Jhamvar, an 11th grade student who learns best by building things, writing about them, and doing both in public."
      />
    </div>

    <Section kicker="Background" heading="How I got here" id="background" headingLevel="h2">
      <div class="prose">
        <p>
          I started this website to make my learning visible and accountable. Instead of only
          consuming information, I try to turn everything I learn into something concrete — a
          project, a system, or a piece of writing that forces me to think clearly.
        </p>
        <p>
          Most of what I write comes out of coding, robotics, and whatever I am actively building.
          I care about how an idea actually survives contact with execution: where it breaks, what
          it costs to fix, and what I would do differently the second time.
        </p>
        <p>
          A lot of how I think comes from sport. I spend a great deal of time analysing football,
          Formula 1, tennis, cricket and the NFL — not just watching, but working out what is
          happening underneath: tactics, decision-making under pressure, momentum, and patterns in
          performance over time. That habit of analysis carries into everything else I do.
        </p>
        <p>
          Music is the other serious thread. I play guitar and piano, sing, and have performed live
          at several concerts. I completed LCM Grade 8 Guitar with High Distinction, which took
          years of consistent graded practice, and I am now working toward diploma level. Daily
          practice is where I learned what mastery and patience actually cost.
        </p>
        <p>
          This site is not a place I post at occasionally. I am building it into a long-term record
          of how I think and what I can do — consistent writing, real projects, and a clear
          direction. Everything here is part of that process.
        </p>
      </div>
    </Section>

    <Section kicker="What drives me" heading="Four things" id="interests" headingLevel="h2">
      <ul class="interest-list">
        {
          interests.map((interest) => (
            <li class="interest">
              <h3 class="interest__title">{interest.title}</h3>
              <p class="interest__detail">{interest.detail}</p>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section kicker="Contact" heading="Let us talk" id="connect" headingLevel="h2">
      <p class="band-text">
        I am always glad to meet people building things, discuss ideas, or work on something
        together.
      </p>
      <p class="band-action">
        <Button href="/contact" variant="primary">Get in touch</Button>
      </p>
    </Section>
  </main>
</BaseLayout>

<style>
  .interest-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .interest {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-top: 1px solid var(--border-subtle);
  }

  @media (min-width: 768px) {
    .interest {
      grid-template-columns: 1fr 3fr;
      gap: var(--space-5);
    }
  }

  .interest__title {
    margin: 0;
    font-size: var(--step-1);
  }

  .interest__detail {
    margin: 0;
    max-width: var(--measure-prose);
    color: var(--text-secondary);
  }

  .band-text {
    margin: 0;
    max-width: var(--measure-prose);
    color: var(--text-secondary);
  }

  .band-action {
    margin: var(--space-5) 0 0;
  }
</style>
