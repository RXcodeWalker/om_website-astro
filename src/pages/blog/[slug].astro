---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/patterns/PostRow.astro';
import Button from '../../components/primitives/Button.astro';
import { site } from '../../config/site';
import { readingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const allPosts = await getCollection('blog');
const related = allPosts
  .filter((entry) => entry.data.category === post.data.category && entry.id !== post.id)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const parsed = new Date(post.data.date);
const validDate = !Number.isNaN(parsed.getTime());
const dateISO = validDate ? parsed.toISOString().slice(0, 10) : undefined;
const dateLabel = validDate
  ? parsed.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : post.data.date;

const minutes = readingTime(post.body ?? '');
const toc = headings.filter((heading) => heading.depth === 2);
const url = new URL(`/blog/${post.id}`, site.url).href;
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  canonical={url}
  ogType="article"
  jsonLd="CreativeWork"
  creativeWork={{
    name: post.data.title,
    description: post.data.excerpt,
    url,
    datePublished: dateISO,
  }}
>
  <div class="progress" id="reading-progress" aria-hidden="true"></div>

  <main id="main">
    <div class="container post">
      <p class="post__back">
        <Button href="/blog" variant="quiet">← All writing</Button>
      </p>

      <article class="post__article">
        <header class="post__header">
          <p class="post__kicker">{post.data.category}</p>
          <h1 class="post__title">{post.data.title}</h1>
          <p class="post__meta tabular-nums">
            <time datetime={dateISO}>{dateLabel}</time>
            <span aria-hidden="true">·</span>
            <span>{minutes} min read</span>
          </p>
        </header>

        {
          toc.length >= 4 && (
            <nav class="post__toc" aria-labelledby="toc-heading">
              <h2 id="toc-heading" class="post__toc-heading">
                On this page
              </h2>
              <ol>
                {toc.map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <div class="prose post__body">
          <Content />
        </div>

        <footer class="post__footer">
          <p class="post__signoff">Thank you for reading. — Om</p>
          <button type="button" class="post__share" id="copy-link">Copy link to this post</button>
          <span class="post__share-status" role="status" aria-live="polite" id="copy-status"
          ></span>
        </footer>
      </article>

      {
        related.length > 0 && (
          <section class="post__related" aria-labelledby="related-heading">
            <h2 id="related-heading" class="post__related-heading">
              More in {post.data.category}
            </h2>
            {related.map((entry) => (
              <PostRow
                href={`/blog/${entry.id}`}
                title={entry.data.title}
                date={entry.data.date}
                excerpt={entry.data.excerpt}
                readingTime={readingTime(entry.body ?? '')}
              />
            ))}
          </section>
        )
      }
    </div>
  </main>
</BaseLayout>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: var(--z-overlay);
    width: 100%;
    height: 2px;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: var(--accent);
  }

  .post {
    padding-block: var(--space-5) var(--space-8);
  }

  .post__back {
    margin: 0 0 var(--space-6);
  }

  .post__article {
    max-width: var(--measure-prose);
  }

  .post__header {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }

  .post__kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .post__title {
    margin: 0;
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--text-muted);
  }

  .post__toc {
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-5);
    background: var(--surface-sunken);
    border: 1px solid var(--border-subtle);
  }

  .post__toc-heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 400;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .post__toc ol {
    margin: 0;
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-2);
    font-size: var(--step--1);
  }

  .post__toc a {
    color: var(--accent);
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .post__toc a:hover,
    .post__toc a:focus-visible {
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }
  }

  .post__body {
    margin-top: var(--space-7);
  }

  .post__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-subtle);
  }

  .post__signoff {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--text-secondary);
  }

  .post__share {
    margin-left: auto;
    min-height: 40px;
    padding-inline: var(--space-4);
    font-size: var(--step--1);
    color: var(--text-primary);
    background: transparent;
    border: 1px solid var(--border-interactive);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    .post__share:hover,
    .post__share:focus-visible {
      background: var(--surface-sunken);
      border-color: var(--text-primary);
    }
  }

  .post__share-status {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--text-muted);
  }

  .post__related {
    margin-top: var(--space-9);
  }

  .post__related-heading {
    margin: 0 0 var(--space-2);
    font-size: var(--step-3);
  }
</style>

<script>
  const bar = document.getElementById('reading-progress');
  if (bar) {
    let ticking = false;
    const update = () => {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = scrollable > 0 ? Math.min(Math.max(window.scrollY / scrollable, 0), 1) : 0;
      bar.style.transform = `scaleX(${ratio})`;
      ticking = false;
    };
    const request = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request, { passive: true });
    update();
  }

  const copy = document.getElementById('copy-link');
  const copyStatus = document.getElementById('copy-status');
  copy?.addEventListener('click', async () => {
    if (!copyStatus) return;
    try {
      await navigator.clipboard.writeText(window.location.href);
      copyStatus.textContent = 'Link copied';
    } catch {
      copyStatus.textContent = window.location.href;
    }
  });
</script>
