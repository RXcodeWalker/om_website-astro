---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/patterns/PageIntro.astro';
import ProjectEntry from '../components/patterns/ProjectEntry.astro';
import EmptyState from '../components/patterns/EmptyState.astro';
import Button from '../components/primitives/Button.astro';
import { site } from '../config/site';

// Nothing about this page is hardcoded. Adding a project is one new directory
// under src/content/projects/ and one `order` value.
const projects = (await getCollection('projects'))
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projects"
  description="Case studies of what Om Jhamvar has built across web, AI and hardware."
  jsonLd="BreadcrumbList"
  breadcrumbs={[
    { name: 'Home', item: site.url },
    { name: 'Projects', item: `${site.url}/projects` },
  ]}
>
  <main id="main">
    <div class="container">
      <PageIntro
        kicker="What I have built"
        title="Projects"
        lede="Each project gets a full case study: what it was for, how it was made, what it cost, and what I would change."
      />

      {
        projects.length > 0 ? (
          <div class="project-list">
            {projects.map((project) => (
              <ProjectEntry project={project} variant="row" />
            ))}
          </div>
        ) : (
          <EmptyState title="Nothing published yet">
            <p>
              The case studies are being written. Each needs its own account of the problem, the
              build, the results and the photographs before it earns a page here — a list of
              project names with a sentence each is not a portfolio.
            </p>
            <p class="empty-actions">
              <Button href={site.blogUrl} variant="quiet" external>Read the writing instead ↗</Button>
            </p>
          </EmptyState>
        )
      }
    </div>
  </main>
</BaseLayout>

<style>
  .project-list {
    margin-top: var(--space-6);
  }

  .empty-actions {
    margin-top: var(--space-4);
  }
</style>
