---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/patterns/PageIntro.astro';
import ProjectEntry from '../components/patterns/ProjectEntry.astro';
import EmptyState from '../components/patterns/EmptyState.astro';
import CtaCard from '../components/patterns/CtaCard.astro';
import Button from '../components/primitives/Button.astro';
import { site } from '../config/site';
import { projectIndexSections, publishedProjects } from '../utils/projects';

const published = publishedProjects(await getCollection('projects'));
const { featured, remaining } = projectIndexSections(published);
---

<BaseLayout
  title="Projects"
  description="A short list of what Om Jhamvar has built, with links to look at the work where it is public."
  jsonLd="BreadcrumbList"
  breadcrumbs={[
    { name: 'Home', item: site.url },
    { name: 'Projects', item: `${site.url}/projects` },
  ]}
>
  <main id="main">
    <PageIntro
      kicker={`Projects · ${published.length} published`}
      title="Work I can"
      titleAccent="point at."
      lede="A short list, on purpose. Each entry says what it is, why it exists, and where you can look at it — a live site, a repository, a write-up, or a note when nothing is public yet."
    />

    <div class="container project-list">
      {
        published.length > 0 ? (
          <>
            {featured.map((project) => (
              <ProjectEntry
                project={project}
                variant="featured"
                headingLevel="h2"
                href={`/projects/${project.id}`}
              />
            ))}
            {remaining.map((project) => (
              <ProjectEntry
                project={project}
                variant="row"
                headingLevel="h2"
                href={`/projects/${project.id}`}
              />
            ))}
          </>
        ) : (
          <EmptyState title="Nothing published yet">
            <p>
              Projects appear here once they have a title, a short account of the work, and either
              a public link or a note explaining why there is not one.
            </p>
            <p class="empty-actions">
              <Button href={site.blogUrl} variant="quiet" external>Read the writing instead ↗</Button>
            </p>
          </EmptyState>
        )
      }
    </div>

    <div class="projects-cta">
      <CtaCard
        id="projects-cta"
        kicker="Next"
        heading="Want the longer"
        accent="story?"
        text="The decisions, the dead ends, and what I would change are written up on the blog as the work happens."
        href={site.blogUrl}
        label="Read the writing"
        external
      />
    </div>
  </main>
</BaseLayout>

<style is:global>
  .project-list {
    display: grid;
    gap: var(--space-6);
    padding-top: var(--space-6);
  }

  .projects-cta {
    padding-top: var(--section-gap);
  }

  .empty-actions {
    margin-top: var(--space-4);
  }

  /* ProjectEntry's row and featured layouts; only this route renders them. */
  .project-entry--featured .project-entry__title {
    font-size: var(--step-4);
  }

  @media (min-width: 768px) {
    .project-entry--row {
      grid-template-columns: 1fr 1fr;
    }

    .project-entry--row > .project-entry__stage {
      display: grid;
      place-items: center;
    }

    .project-entry--row > .project-entry__body {
      align-content: center;
      padding: var(--space-6);
    }

    .project-entry--row:nth-of-type(even) > .project-entry__stage {
      order: 2;
    }
  }

  @media (min-width: 1024px) {
    .project-entry--featured {
      grid-template-columns: 7fr 5fr;
      min-height: 520px;
    }

    .project-entry--featured > .project-entry__stage {
      display: grid;
      place-items: center;
    }

    .project-entry--featured > .project-entry__body {
      align-content: center;
      padding: var(--space-8) var(--space-7);
    }
  }
</style>
