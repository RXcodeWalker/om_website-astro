---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/primitives/Section.astro';
import Button from '../components/primitives/Button.astro';
import ProjectEntry from '../components/patterns/ProjectEntry.astro';
import AchievementItem from '../components/patterns/AchievementItem.astro';
import NowBand from '../components/patterns/NowBand.astro';
import PostRow from '../components/patterns/PostRow.astro';
import { site } from '../config/site';
import type { Achievement } from '../schemas/achievement';

const projects = (await getCollection('projects'))
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const nowEntries = await getCollection('now');
const now = nowEntries[0]?.data;

// Writing picks are curated in YAML — preserve their order, do not sort.
const picks = await getCollection('writing');

// Achievements: only highlighted entries, capped at 3.
const achievementEntries = await getCollection('achievements');
const highlights = achievementEntries
  .map((e) => e.data as Achievement)
  .filter((a) => a.highlight)
  .slice(0, 3);
---

<BaseLayout
  title={site.name}
  description={site.description}
  breadcrumbs={[{ name: 'Home', item: site.url }]}
>
  <main id="main">

    {/* ── 1. Hero ─────────────────────────────────────────────── */}
    <section class="hero">
      <div class="container hero__inner">
        <p class="hero__kicker">Om Jhamvar · Mumbai</p>
        <h1 class="hero__title">I build the tools I wish I'd had.</h1>
        <p class="hero__lede">
          Currently: an AI speaking coach for IGCSE French learners, and an autonomous
          robot built at an IIT makerspace. This site keeps the work honest and in public.
        </p>
        <div class="hero__actions">
          <Button href="/projects" variant="primary" size="lg">See the work</Button>
          <Button href="/about" variant="secondary" size="lg">About me</Button>
          <Button href="/contact" variant="quiet" size="lg">Get in touch</Button>
        </div>
      </div>
    </section>

    {/* ── 2. Selected work ────────────────────────────────────── */}
    <Section kicker="Selected work" heading="Projects" id="projects" headingLevel="h2">
      {projects.length > 0 ? (
        <div class="stack">
          {projects.map((project) => (
            <ProjectEntry
              project={project}
              variant="compact"
              href={`/projects#${project.id}`}
            />
          ))}
        </div>
      ) : (
        <p class="band-text">
          Case studies in progress — each needs a full account of the problem, the build,
          and the results before it earns a page here.
        </p>
      )}
      <p class="band-action">
        <Button href="/projects" variant="quiet" size="md">All projects →</Button>
      </p>
    </Section>

    {/* ── 3. Achievements ─────────────────────────────────────── */}
    {highlights.length > 0 && (
      <Section kicker="Evidence" heading="Achievements" id="achievements" headingLevel="h2">
        <div>
          {highlights.map((achievement) => (
            <AchievementItem achievement={achievement} />
          ))}
        </div>
        <p class="band-action">
          <Button href="/achievements" variant="quiet" size="md">All achievements →</Button>
        </p>
      </Section>
    )}

    {/* ── 4. Currently ────────────────────────────────────────── */}
    {now && (
      <Section kicker="Currently" heading="What I am working on" id="now" headingLevel="h2">
        <NowBand entry={now} />
      </Section>
    )}

    {/* ── 5. About preview ────────────────────────────────────── */}
    <Section kicker="The person" heading="About me" id="about" headingLevel="h2">
      <div class="about-preview">
        <p class="about-preview__text">
          I learn by building things and writing about them. Guitar and music are the other
          serious thread — LCM Grade 8 with High Distinction, working toward diploma level,
          daily practice. I analyse sport the same way I analyse code: as systems where
          structure decides outcomes.
        </p>
        <p class="about-preview__text">
          This site is the long-term record of how I think and what I can do.
        </p>
      </div>
      <p class="band-action">
        <Button href="/about" variant="secondary" size="md">More about me</Button>
      </p>
    </Section>

    {/* ── 6. Writing ──────────────────────────────────────────── */}
    <Section kicker="Writing" heading="Selected essays" id="writing" headingLevel="h2">
      {picks.length > 0 ? (
        <div class="stack stack--tight">
          {picks.map((pick) => (
            <PostRow
              href={pick.data.url}
              title={pick.data.title}
              date={pick.data.date.toISOString()}
              excerpt={pick.data.excerpt}
              external
            />
          ))}
        </div>
      ) : (
        <p class="band-text">
          Essays and notes on coding, robotics, sport and whatever I am currently trying to
          understand properly.
        </p>
      )}
      <p class="band-action">
        <Button href={site.blogUrl} variant="quiet" size="md" external>Explore all writing ↗</Button>
      </p>
    </Section>

    {/* ── 7. Contact CTA ──────────────────────────────────────── */}
    <Section kicker="Contact" heading="Let us talk" id="contact" headingLevel="h2">
      <p class="band-text">
        Open to collaboration, academic conversations, project discussions, and
        opportunities. I reply to everything within a day or so.
      </p>
      <p class="band-action">
        <Button href="/contact" variant="secondary" size="md">Get in touch</Button>
      </p>
    </Section>

  </main>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────── */
  .hero {
    padding-block: var(--space-9) var(--space-8);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-4);
  }

  .hero__kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* The only place --step-5 is permitted. */
  .hero__title {
    margin: 0;
    max-width: 20ch;
    font-size: var(--step-5);
    line-height: var(--leading-tight);
  }

  .hero__lede {
    margin: 0;
    max-width: var(--measure-narrow);
    font-size: var(--step-1);
    line-height: var(--leading-prose);
    color: var(--text-secondary);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  /* ── Shared band utilities ────────────────────────────────────── */
  .stack--tight {
    --stack-gap: 0;
  }

  .band-text {
    margin: 0;
    max-width: var(--measure-prose);
    color: var(--text-secondary);
  }

  .band-action {
    margin: var(--space-5) 0 0;
  }

  /* ── About preview ────────────────────────────────────────────── */
  .about-preview {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure-prose);
  }

  .about-preview__text {
    margin: 0;
    color: var(--text-secondary);
  }
</style>
