---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/primitives/Section.astro';
import Button from '../components/primitives/Button.astro';
import ProjectEntry from '../components/patterns/ProjectEntry.astro';
import PostRow from '../components/patterns/PostRow.astro';
import NowBand from '../components/patterns/NowBand.astro';
import EmptyState from '../components/patterns/EmptyState.astro';
import { site } from '../config/site';

const projects = (await getCollection('projects'))
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const nowEntries = await getCollection('now');
const now = nowEntries[0]?.data;

const picks = await getCollection('writing');

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<BaseLayout
  title={site.name}
  description={site.description}
  breadcrumbs={[{ name: 'Home', item: site.url }]}
>
  <main id="main">
    <section class="hero">
      <div class="container hero__inner">
        <p class="hero__kicker">{site.tagline}</p>
        <h1 class="hero__title">I learn by building things and writing about them.</h1>
        <p class="hero__lede">
          I am Om Jhamvar, a school student who turns what he learns into projects, essays and
          performances. This site is where that work is kept honest and in public.
        </p>
        <div class="hero__actions">
          <Button href="/projects" variant="primary" size="lg">See the work</Button>
          <Button href="/about" variant="secondary" size="lg">About me</Button>
        </div>
      </div>
    </section>

    <Section kicker="Selected work" heading="Projects" id="projects" headingLevel="h2">
      {
        projects.length > 0 ? (
          <div class="stack">
            {projects.map((project) => (
              <ProjectEntry project={project} variant="compact" />
            ))}
          </div>
        ) : (
          <EmptyState title="Case studies in progress">
            <p>
              The project case studies are being written against the new content model. Each one
              needs its own write-up, photographs and results before it is worth publishing.
            </p>
          </EmptyState>
        )
      }
      <p class="band-action">
        <Button href="/projects" variant="quiet">All projects →</Button>
      </p>
    </Section>

    {
      now && (
        <Section kicker="Currently" heading="What I am working on" id="now" headingLevel="h2">
          <NowBand entry={now} />
        </Section>
      )
    }

    <Section kicker="Writing" heading="Recent posts" id="writing" headingLevel="h2">
      {
        picks.length > 0 ? (
          <div class="stack stack--tight">
            {picks.map((pick) => (
              <PostRow
                href={pick.data.url}
                title={pick.data.title}
                date={pick.data.date.toISOString()}
                excerpt={pick.data.excerpt}
              />
            ))}
          </div>
        ) : (
          <div class="stack stack--tight">
            {posts.map((post) => (
              <PostRow
                href={`/blog/${post.id}`}
                title={post.data.title}
                category={post.data.category}
                date={post.data.date}
                excerpt={post.data.excerpt}
              />
            ))}
          </div>
        )
      }
      <p class="band-action">
        <Button href="/blog" variant="quiet">All writing →</Button>
      </p>
    </Section>

    <Section kicker="Contact" heading="Get in touch" id="contact" headingLevel="h2">
      <p class="band-text">
        I am always glad to hear from people building things, and I reply to everything within a
        day or so.
      </p>
      <p class="band-action">
        <Button href="/contact" variant="secondary">Contact me</Button>
      </p>
    </Section>
  </main>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-9) var(--space-8);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-4);
  }

  .hero__kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* The only place --step-5 is permitted. */
  .hero__title {
    margin: 0;
    max-width: 20ch;
    font-size: var(--step-5);
    line-height: var(--leading-tight);
  }

  .hero__lede {
    margin: 0;
    max-width: var(--measure-narrow);
    font-size: var(--step-1);
    line-height: var(--leading-prose);
    color: var(--text-secondary);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .stack--tight {
    --stack-gap: 0;
  }

  .band-text {
    margin: 0;
    max-width: var(--measure-prose);
    color: var(--text-secondary);
  }

  .band-action {
    margin: var(--space-5) 0 0;
  }
</style>
