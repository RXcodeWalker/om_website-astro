---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/patterns/PageIntro.astro';
import PostRow from '../components/patterns/PostRow.astro';
import { site } from '../config/site';
import { readingTime } from '../utils/readingTime';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const categories = [...new Set(posts.map((post) => post.data.category))].sort();
---

<BaseLayout
  title="Writing"
  description="Essays and notes by Om Jhamvar on building, sport, music and learning in public."
  jsonLd="BreadcrumbList"
  breadcrumbs={[
    { name: 'Home', item: site.url },
    { name: 'Writing', item: `${site.url}/blog` },
  ]}
>
  <main id="main">
    <div class="container">
      <PageIntro
        kicker="Writing"
        title="Notes and essays"
        lede="Coding, robotics, sport read as systems, music, and whatever I am currently trying to understand properly."
      />

      {/* Controls do nothing without JS, so they only appear once JS is confirmed. */}
      <div class="blog-controls" id="blog-controls" hidden>
        <div class="blog-controls__search">
          <label for="post-search">Search posts</label>
          <input
            type="search"
            id="post-search"
            name="q"
            autocomplete="off"
            placeholder="Search titles and excerpts"
          />
        </div>

        <div class="blog-controls__filters" role="group" aria-label="Filter by category">
          <button type="button" class="filter" data-category="all" aria-pressed="true">All</button>
          {
            categories.map((category) => (
              <button type="button" class="filter" data-category={category} aria-pressed="false">
                {category}
              </button>
            ))
          }
        </div>

        <p class="blog-controls__status" role="status" aria-live="polite" id="search-status"></p>
      </div>

      <div class="post-list" id="post-list">
        {
          posts.map((post) => (
            <div
              class="post-list__item"
              data-category={post.data.category}
              data-title={post.data.title.toLowerCase()}
              data-excerpt={post.data.excerpt.toLowerCase()}
            >
              <PostRow
                href={`/blog/${post.id}`}
                title={post.data.title}
                category={post.data.category}
                date={post.data.date}
                excerpt={post.data.excerpt}
                readingTime={readingTime(post.body ?? '')}
              />
            </div>
          ))
        }
      </div>

      <p class="post-list__empty" id="post-list-empty" hidden>
        No posts match that search. <button type="button" id="reset-search">Clear filters</button>
      </p>
    </div>
  </main>
</BaseLayout>

<style>
  .blog-controls {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }

  :global(html.js) .blog-controls[hidden] {
    display: grid;
  }

  .blog-controls__search {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure-narrow);
  }

  .blog-controls__search label {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .blog-controls__search input {
    width: 100%;
    padding: var(--space-3);
    color: var(--text-primary);
    background: var(--surface-raised);
    border: 1px solid var(--border-interactive);
    border-radius: var(--radius-sm);
  }

  .blog-controls__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter {
    min-height: 32px;
    padding: var(--space-1) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .filter[aria-pressed='true'] {
    color: var(--text-on-accent);
    background: var(--accent);
    border-color: var(--accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .filter:hover,
    .filter:focus-visible {
      border-color: var(--text-primary);
    }
  }

  .blog-controls__status {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--text-muted);
  }

  .blog-controls__status:empty {
    display: none;
  }

  .post-list__item[hidden] {
    display: none;
  }

  .post-list__empty {
    padding-block: var(--space-7);
    color: var(--text-secondary);
  }

  .post-list__empty button {
    color: var(--accent);
    background: none;
    border: 0;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    cursor: pointer;
  }
</style>

<script>
  const controls = document.getElementById('blog-controls');
  const search = document.getElementById('post-search') as HTMLInputElement | null;
  const status = document.getElementById('search-status');
  const empty = document.getElementById('post-list-empty');
  const reset = document.getElementById('reset-search');
  const items = Array.from(
    document.querySelectorAll<HTMLElement>('.post-list__item'),
  );
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter'));

  if (controls && search && items.length > 0) {
    controls.hidden = false;

    let category = 'all';

    const apply = () => {
      const query = search.value.trim().toLowerCase();
      let shown = 0;

      for (const item of items) {
        const matchesCategory = category === 'all' || item.dataset.category === category;
        const matchesQuery =
          query === '' ||
          (item.dataset.title ?? '').includes(query) ||
          (item.dataset.excerpt ?? '').includes(query);
        const visible = matchesCategory && matchesQuery;
        item.hidden = !visible;
        if (visible) shown += 1;
      }

      if (status) {
        status.textContent =
          query === '' && category === 'all'
            ? ''
            : `${shown} of ${items.length} posts`;
      }
      if (empty) empty.hidden = shown > 0;
    };

    search.addEventListener('input', apply);

    filters.forEach((button) => {
      button.addEventListener('click', () => {
        category = button.dataset.category ?? 'all';
        filters.forEach((other) => {
          other.setAttribute('aria-pressed', String(other === button));
        });
        apply();
      });
    });

    reset?.addEventListener('click', () => {
      search.value = '';
      category = 'all';
      filters.forEach((other) => {
        other.setAttribute('aria-pressed', String(other.dataset.category === 'all'));
      });
      apply();
      search.focus();
    });
  }
</script>
