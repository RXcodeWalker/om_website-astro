---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/patterns/PageIntro.astro';
import ContactForm from '../components/patterns/ContactForm.astro';
import { site } from '../config/site';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Om Jhamvar about projects, collaboration, or anything else."
  jsonLd="BreadcrumbList"
  breadcrumbs={[
    { name: 'Home', item: site.url },
    { name: 'Contact', item: `${site.url}/contact` },
  ]}
>
  <main id="main">
    <div class="container">
      <PageIntro
        kicker="Say hello"
        title="Get in touch"
        lede="A question, a collaboration, or an argument about football tactics — all welcome. I reply within a day or so."
      />

      <div class="contact-layout">
        <section aria-labelledby="contact-form-heading">
          <h2 id="contact-form-heading" class="contact-heading">Send a message</h2>
          <ContactForm />
        </section>

        <section aria-labelledby="contact-direct-heading">
          <h2 id="contact-direct-heading" class="contact-heading">Or reach me directly</h2>
          <dl class="contact-direct">
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
            </div>
            {
              site.socials.map((social) => (
                <div>
                  <dt>{social.label}</dt>
                  <dd>
                    <a href={social.href} class="link-external" rel="noopener noreferrer">
                      {social.href.replace(/^https:\/\/(www\.)?/, '')}
                    </a>
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .contact-layout {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-7);
    padding-bottom: var(--space-8);
  }

  @media (min-width: 1024px) {
    .contact-layout {
      grid-template-columns: 7fr 4fr;
      gap: var(--space-9);
    }
  }

  .contact-heading {
    margin: 0 0 var(--space-5);
    font-size: var(--step-2);
  }

  .contact-direct {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  .contact-direct div {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .contact-direct dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .contact-direct dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .contact-direct a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
