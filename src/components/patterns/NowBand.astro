---
import type { NowEntry } from '../../schemas/now';

interface Props {
  entry: NowEntry;
  projectHref?: string;
}

const { entry, projectHref } = Astro.props;

const updatedISO = entry.updated.toISOString().slice(0, 10);
const updatedLabel = entry.updated.toLocaleDateString('en-GB', {
  month: 'long',
  year: 'numeric',
});
---

<div class="now-band">
  <div class="now-band__lead">
    <p class="now-band__focus">{entry.focus}</p>

    {
      projectHref && (
        <p class="now-band__related">
          <a class="link-ui link-arrow tap-target" href={projectHref}>
            Related project <span class="link-arrow__icon" aria-hidden="true">→</span>
          </a>
        </p>
      )
    }

    {/* The stamp is the honesty mechanism, not decoration. */}
    <p class="now-band__stamp tabular-nums">
      <span class="pulse-dot" aria-hidden="true"></span>
      Updated <time datetime={updatedISO}>{updatedLabel}</time>
    </p>
  </div>

  {
    entry.strands.length > 0 && (
      <ul class="now-band__strands">
        {entry.strands.map((strand, i) => (
          <li class="now-strand surface-card reveal" style={`--i: ${i}`}>
            <p class="now-strand__index tabular-nums" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </p>
            <p class="now-strand__label eyebrow">{strand.label}</p>
            <p class="now-strand__title">{strand.title}</p>
            <p class="now-strand__detail">{strand.detail}</p>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .now-band {
    display: grid;
    gap: var(--space-7);
  }

  .now-band__lead {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .now-band__focus {
    margin: 0;
    max-width: var(--measure-prose);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    color: var(--text-primary);
  }

  .now-band__related {
    margin: 0;
  }

  .now-band__related a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
    color: var(--accent);
  }

  .now-band__stamp {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--text-muted);
  }

  .now-band__strands {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .now-strand {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-xl);
  }

  .now-strand__index {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--accent);
  }

  .now-strand__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: var(--leading-snug);
  }

  .now-strand__detail {
    margin: 0;
    max-width: var(--measure-prose);
    color: var(--text-secondary);
  }

  @media (min-width: 1024px) {
    .now-band {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-8);
      align-items: start;
    }

    .now-band__lead {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
  }
</style>
