---
import type { NowEntry } from '../../schemas/now';

interface Props {
  entry: NowEntry;
}

const { entry } = Astro.props;

const updatedISO = entry.updated.toISOString().slice(0, 10);
const updatedLabel = entry.updated.toLocaleDateString('en-GB', {
  month: 'long',
  year: 'numeric',
});
---

<div class="now-band">
  <p class="now-band__focus">{entry.focus}</p>

  {
    entry.strands.length > 0 && (
      <ul class="now-band__strands">
        {entry.strands.map((strand) => (
          <li class="now-strand">
            <p class="now-strand__label">{strand.label}</p>
            <div class="now-strand__body">
              <p class="now-strand__title">{strand.title}</p>
              <p class="now-strand__detail">{strand.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    )
  }

  {/* The stamp is the honesty mechanism, not decoration. */}
  <p class="now-band__stamp tabular-nums">
    Updated <time datetime={updatedISO}>{updatedLabel}</time>
  </p>
</div>

<style>
  .now-band {
    display: grid;
    gap: var(--space-5);
  }

  .now-band__focus {
    margin: 0;
    max-width: var(--measure-prose);
    font-size: var(--step-1);
    line-height: var(--leading-prose);
  }

  .now-band__strands {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .now-strand {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-top: 1px solid var(--border-subtle);
  }

  @media (min-width: 768px) {
    .now-strand {
      grid-template-columns: 1fr 3fr;
      gap: var(--space-5);
    }
  }

  .now-strand__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-muted);
    padding-top: var(--space-1);
  }

  .now-strand__body {
    display: grid;
    gap: var(--space-2);
  }

  .now-strand__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
  }

  .now-strand__detail {
    margin: 0;
    max-width: var(--measure-prose);
    color: var(--text-secondary);
  }

  .now-band__stamp {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--text-muted);
  }
</style>
