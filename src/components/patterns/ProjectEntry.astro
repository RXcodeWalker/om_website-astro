---
import type { CollectionEntry } from 'astro:content';
import Media from '../primitives/Media.astro';
import ChipList from '../primitives/ChipList.astro';
import StatusBadge from '../primitives/StatusBadge.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  variant?: 'row' | 'compact' | 'featured';
  headingLevel?: 'h2' | 'h3';
  /**
   * When false, the title is not a link and no stretched overlay is emitted.
   * Homepage compact keeps the default (true) and still anchors to /projects#id.
   */
  linked?: boolean;
  /** Defaults to /projects#<id> when linked. */
  href?: string;
}

const {
  project,
  variant = 'row',
  headingLevel = 'h3',
  linked = true,
  href,
} = Astro.props;
const { data } = project;
const linkHref = href ?? `/projects#${project.id}`;
const Heading = headingLevel;
const showSummary = variant !== 'compact';
const showExplore = variant !== 'compact';
const explore = [
  ...data.links,
  ...(data.relatedPost
    ? [{ label: data.relatedPost.title, href: data.relatedPost.url }]
    : []),
];
const chipMax = variant === 'compact' ? 3 : 5;
---

<article
  id={project.id}
  class:list={[
    'project-entry',
    `project-entry--${variant}`,
    !data.thumbnail && 'project-entry--text-only',
  ]}
>
  {data.thumbnail && (
    <div class="project-entry__media">
      <Media
        src={data.thumbnail.src}
        alt={data.thumbnail.alt}
        ratio="16:10"
        eager={variant === 'featured'}
        sizes={
          variant === 'featured'
            ? '(min-width: 1120px) 1120px, 100vw'
            : variant === 'row'
              ? '(min-width: 1024px) 440px, 100vw'
              : '(min-width: 1024px) 320px, 100vw'
        }
      />
    </div>
  )}

  <div class="project-entry__body">
    {data.kicker && <p class="project-entry__kicker">{data.kicker}</p>}

    <Heading class="project-entry__title">
      {linked ? (
        <a href={linkHref} class="project-entry__link">{data.title}</a>
      ) : (
        data.title
      )}
    </Heading>

    <p class="project-entry__outcome">{data.outcome}</p>

    {showSummary && <p class="project-entry__summary">{data.summary}</p>}

    <div class="project-entry__meta">
      <StatusBadge status={data.status} />
      <time class="project-entry__year tabular-nums" datetime={String(data.year)}>
        {data.year}
      </time>
    </div>

    <ChipList items={[...data.stack]} max={chipMax} />

    {showExplore && explore.length > 0 && (
      <ul class="project-entry__actions" aria-label={`Explore ${data.title}`}>
        {explore.map((item) => (
          <li>
            <a class="link-ui link-external" href={item.href} rel="noopener">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    )}

    {showExplore && explore.length === 0 && data.linksNote && (
      <p class="project-entry__note">{data.linksNote}</p>
    )}
  </div>
</article>

<style>
  .project-entry {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .project-entry--featured {
    padding-block: var(--space-8);
  }

  @media (min-width: 768px) {
    .project-entry--row:not(.project-entry--text-only) {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-6);
      align-items: start;
    }
  }

  .project-entry__body {
    display: grid;
    gap: var(--space-3);
  }

  .project-entry__kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .project-entry__title {
    margin: 0;
    font-size: var(--step-2);
  }

  .project-entry--featured .project-entry__title {
    font-size: var(--step-3);
  }

  .project-entry__link {
    color: inherit;
    text-decoration: none;
  }

  .project-entry__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project-entry__outcome {
    margin: 0;
    color: var(--text-primary);
  }

  .project-entry__summary {
    margin: 0;
    max-width: var(--measure-prose);
    color: var(--text-secondary);
  }

  .project-entry__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .project-entry__year {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--text-muted);
  }

  .project-entry__actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-entry__actions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .project-entry__note {
    margin: 0;
    max-width: var(--measure-prose);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .project-entry__media :global(.media) {
    transition: transform var(--dur-base) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .project-entry:hover {
      border-color: var(--border-strong);
    }

    .project-entry:hover .project-entry__link {
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }

    .project-entry:hover .project-entry__media :global(img) {
      transform: scale(1.02);
    }
  }

  .project-entry:has(:focus-visible) {
    border-color: var(--border-strong);
  }
</style>
