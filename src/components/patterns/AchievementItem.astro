---
import type { Achievement } from '../../schemas/achievement';

interface Props {
  achievement: Achievement;
  variant?: 'featured' | 'row' | 'card';
  relatedHref?: string;
}

const { achievement, variant = 'row', relatedHref } = Astro.props;

const dateISO = achievement.date.toISOString().slice(0, 10);
const dateLabel = achievement.date.toLocaleDateString('en-GB', {
  month: 'short',
  year: 'numeric',
});

const evidence = achievement.evidence;
---

<article class:list={['achievement', `achievement--${variant}`, 'reveal']}>
  {achievement.credential && <p class="achievement__stat accent-text" aria-hidden="true">{achievement.credential}</p>}
  <div class="achievement__head">
    <h3 class="achievement__title">{achievement.title}</h3>
    <p class="achievement__meta tabular-nums">
      <span>{achievement.issuer}</span>
      <span class="achievement__sep" aria-hidden="true">·</span>
      <time datetime={dateISO}>{dateLabel}</time>
      {achievement.credential && (
        <>
          <span class="achievement__sep" aria-hidden="true">·</span>
          <span>{achievement.credential}</span>
        </>
      )}
    </p>
  </div>

  <p class="achievement__significance">{achievement.significance}</p>

  {
    (evidence.length > 0 || relatedHref) && (
      <ul class="achievement__links">
        {evidence.map((item) => (
          <li>
            <a href={item.href} class="link-ui link-external" target="_blank" rel="noopener noreferrer">
              {item.label}
            </a>
          </li>
        ))}
        {relatedHref && (
          <li>
            <a class="link-ui" href={relatedHref}>
              Related project
            </a>
          </li>
        )}
      </ul>
    )
  }
</article>

<style is:global>
  .achievement {
    position: relative;
    display: grid;
    gap: var(--space-3);
    transition:
      background-color var(--dur-base),
      box-shadow var(--dur-base),
      translate var(--dur-slower) var(--ease-spring);
  }

  .achievement__head {
    display: grid;
    gap: var(--space-2);
  }

  .achievement__title {
    margin: 0;
    font-size: var(--step-2);
  }

  .achievement__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .achievement__sep {
    color: var(--highlight-soft);
  }

  .achievement__significance {
    margin: 0;
    max-width: var(--measure-prose);
    color: var(--text-secondary);
  }

  .achievement__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .achievement__links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding-inline: 14px;
    font-size: var(--step--1);
    border-radius: var(--radius-full);
    border: 1px solid var(--glass-border);
    background: var(--glass-bg-strong);
  }

  @media (hover: hover) and (pointer: fine) {
    .achievement__links a:is(:hover, :focus-visible) {
      text-decoration: none;
      border-color: var(--border-strong);
    }
  }

  @media (pointer: coarse) {
    .achievement__links a {
      min-height: 44px;
    }
  }

  /* Row and featured typography live in achievements.astro, the only route that renders them. */
  .achievement--featured,
  .achievement--card {
    align-content: start;
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    border-radius: var(--radius-2xl);
    background: var(--card-bg);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-highlight), var(--shadow-1);
  }

  @media (hover: hover) and (pointer: fine) {
    .achievement--featured:hover,
    .achievement--card:hover {
      translate: 0 -4px;
      box-shadow: var(--glass-highlight), var(--shadow-2);
    }
  }

  .achievement--card .achievement__stat {
    font-size: var(--step-4);
  }

  .achievement--card .achievement__significance {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .achievement__stat {
    justify-self: start;
    margin: 0 0 var(--space-3);
    padding-bottom: 0.12em;
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: 400;
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }
</style>
