---
import { site } from '../../config/site';
import Icon from '../primitives/Icon.astro';
---

<form
  class="contact-form"
  action={`https://formspree.io/f/${site.formspreeId}`}
  method="POST"
  data-fallback={`Could not send. Please email ${site.email} instead.`}
>
  <input type="hidden" name="subject" value="New message from Beyond The Basics" />

  <p class="visually-hidden">
    <label for="contact-gotcha">Leave this field blank</label>
    <input
      id="contact-gotcha"
      class="visually-hidden"
      type="text"
      name="_gotcha"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />
  </p>

  <div class="contact-form__grid">
    <div class="contact-form__field">
      <label for="contact-name">Name</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required />
      <p id="contact-name-error" class="contact-form__error" hidden></p>
    </div>
    <div class="contact-form__field">
      <label for="contact-email">Email</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" required />
      <p id="contact-email-error" class="contact-form__error" hidden></p>
    </div>
  </div>

  <div class="contact-form__field">
    <label for="contact-message">Message</label>
    <textarea
      id="contact-message"
      name="message"
      rows="6"
      required
      aria-describedby="contact-hint"></textarea>
    <p id="contact-hint" class="contact-form__hint">I usually reply within 24 hours.</p>
    <p id="contact-message-error" class="contact-form__error" hidden></p>
  </div>

  <p class="contact-form__privacy">
    Submissions go through Formspree so they can be emailed. Do not send secrets.
  </p>

  <p
    class="contact-form__status"
    id="contact-status"
    role="status"
    aria-live="polite"
    aria-atomic="true"
    tabindex="-1"
  ></p>

  <button type="submit" class="contact-form__submit" data-magnetic>
    <span class="contact-form__submit-label">Send message</span>
    <Icon name="arrow-right" />
  </button>
</form>

<style>
  .contact-form {
    display: grid;
    gap: var(--space-5);
    max-width: var(--container-narrow);
  }

  .contact-form__grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 480px) {
    .contact-form__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-form__field {
    display: grid;
    gap: var(--space-2);
  }

  .contact-form__field label {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .contact-form__field input,
  .contact-form__field textarea {
    width: 100%;
    min-height: 52px;
    padding: 14px 16px;
    color: var(--text-primary);
    background: var(--glass-bg-strong);
    border: 1px solid var(--border-interactive);
    border-radius: var(--radius-lg);
    box-shadow: var(--glass-highlight);
    transition:
      border-color var(--dur-base),
      box-shadow var(--dur-base),
      background-color var(--dur-base);
  }

  .contact-form__field textarea {
    min-height: 180px;
    resize: vertical;
  }

  .contact-form__field input:focus-visible,
  .contact-form__field textarea:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .contact-form__field input:user-invalid,
  .contact-form__field textarea:user-invalid,
  .contact-form__field input[aria-invalid='true'],
  .contact-form__field textarea[aria-invalid='true'] {
    border-color: var(--status-error);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--status-error) 16%, transparent);
  }

  .contact-form__hint,
  .contact-form__privacy {
    margin: 0;
    font-size: var(--step--2);
    color: var(--text-muted);
  }

  .contact-form__error {
    margin: 0;
    font-size: var(--step--1);
    color: var(--status-error);
  }

  .contact-form__status:empty {
    display: none;
  }

  .contact-form__status {
    margin: 0;
    padding: var(--space-4);
    font-size: var(--step--1);
    color: var(--text-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--glass-border);
    background: var(--glass-bg-strong);
  }

  .contact-form__status[data-state='success'] {
    border-color: var(--status-shipped);
    box-shadow: inset 3px 0 0 var(--status-shipped);
  }

  .contact-form__status[data-state='error'] {
    border-color: var(--status-error);
    box-shadow: inset 3px 0 0 var(--status-error);
  }

  .contact-form__submit {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 52px;
    padding-inline: 28px;
    font-weight: 500;
    color: var(--text-on-accent);
    background: var(--accent);
    border: 0;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-1);
    cursor: pointer;
    transform: translate(var(--tx, 0), var(--ty, 0));
    transition:
      transform var(--dur-base) var(--ease-spring),
      background-color var(--dur-base) var(--ease-spring),
      box-shadow var(--dur-base) var(--ease-spring);
  }

  .contact-form__submit::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      115deg,
      transparent 30%,
      rgb(255 255 255 / 0.28) 50%,
      transparent 70%
    );
    transform: translateX(-120%);
    transition: transform 700ms var(--ease-spring);
  }

  .contact-form__submit :global(svg) {
    transition: transform var(--dur-base) var(--ease-spring);
  }

  .contact-form__submit:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  .contact-form[aria-busy='true'] .contact-form__submit :global(svg) {
    animation: spin 0.9s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-form__submit:hover:not(:disabled),
    .contact-form__submit:focus-visible {
      background: var(--accent-hover);
      box-shadow: var(--shadow-glow);
    }

    .contact-form__submit:hover:not(:disabled)::before,
    .contact-form__submit:focus-visible::before {
      transform: translateX(120%);
    }

    .contact-form__submit:hover:not(:disabled) :global(svg) {
      transform: translateX(3px);
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  const status = document.getElementById('contact-status');
  const fallback = form?.dataset.fallback ?? 'Could not send. Please email instead.';

  function isFailurePayload(body: unknown) {
    if (!body || typeof body !== 'object') return false;
    const record = body as Record<string, unknown>;
    if (record.ok === false) return true;
    if (typeof record.error === 'string' && record.error.length > 0) return true;
    if (Array.isArray(record.errors) && record.errors.length > 0) return true;
    return false;
  }

  function formspreeErrorMessage(body: unknown, fallbackMessage: string) {
    if (!body || typeof body !== 'object') return fallbackMessage;
    const record = body as Record<string, unknown>;
    if (Array.isArray(record.errors)) {
      const messages = record.errors
        .map((item: unknown) =>
          item && typeof item === 'object' && 'message' in item && typeof item.message === 'string'
            ? item.message
            : '',
        )
        .filter(Boolean);
      if (messages.length > 0) return messages.join(' ');
    }
    if (typeof record.error === 'string' && record.error.length > 0) return record.error;
    return fallbackMessage;
  }

  function setFieldInvalid(
    field: HTMLInputElement | HTMLTextAreaElement,
    errorId: string,
    baseDescribedBy?: string,
  ) {
    const error = document.getElementById(errorId);
    field.setAttribute('aria-invalid', 'true');
    field.setAttribute(
      'aria-describedby',
      [baseDescribedBy, errorId].filter(Boolean).join(' '),
    );
    if (error) {
      error.hidden = false;
      error.textContent = field.validationMessage;
    }
  }

  function clearFieldInvalid(
    field: HTMLInputElement | HTMLTextAreaElement,
    errorId: string,
    baseDescribedBy?: string,
  ) {
    const error = document.getElementById(errorId);
    field.removeAttribute('aria-invalid');
    if (baseDescribedBy) field.setAttribute('aria-describedby', baseDescribedBy);
    else field.removeAttribute('aria-describedby');
    if (error) {
      error.hidden = true;
      error.textContent = '';
    }
  }

  form?.addEventListener('submit', async (event) => {
    if (!(form instanceof HTMLFormElement) || !status) return;
    event.preventDefault();

    if (form.getAttribute('aria-busy') === 'true') return;

    const submit = form.querySelector('.contact-form__submit');
    const name = form.querySelector('#contact-name');
    const email = form.querySelector('#contact-email');
    const message = form.querySelector('#contact-message');
    if (
      !(name instanceof HTMLInputElement) ||
      !(email instanceof HTMLInputElement) ||
      !(message instanceof HTMLTextAreaElement)
    ) {
      return;
    }

    clearFieldInvalid(name, 'contact-name-error');
    clearFieldInvalid(email, 'contact-email-error');
    clearFieldInvalid(message, 'contact-message-error', 'contact-hint');

    const fields = [
      { field: name, errorId: 'contact-name-error' },
      { field: email, errorId: 'contact-email-error' },
      { field: message, errorId: 'contact-message-error', describedBy: 'contact-hint' },
    ];

    const invalid = fields.filter(({ field }) => !field.checkValidity());
    if (invalid.length > 0) {
      for (const item of invalid) {
        setFieldInvalid(item.field, item.errorId, item.describedBy);
      }
      invalid[0]?.field.focus();
      return;
    }

    const label = submit?.querySelector('.contact-form__submit-label');
    const submitLabel = label ? label.textContent : 'Send message';
    delete status.dataset.state;
    form.setAttribute('aria-busy', 'true');
    if (submit instanceof HTMLButtonElement) {
      submit.disabled = true;
      if (label) label.textContent = 'Sending…';
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      let body = null;
      const contentType = response.headers.get('content-type') ?? '';
      if (contentType.includes('application/json')) {
        try {
          body = await response.json();
        } catch {
          body = null;
        }
      }

      if (!response.ok || isFailurePayload(body)) {
        throw new Error(formspreeErrorMessage(body, fallback));
      }

      form.reset();
      status.textContent = 'Sent. Thank you — I will reply within 24 hours.';
      status.dataset.state = 'success';
      status.focus();
    } catch (error) {
      status.textContent = error instanceof Error && error.message ? error.message : fallback;
      status.dataset.state = 'error';
      status.focus();
    } finally {
      form.removeAttribute('aria-busy');
      if (submit instanceof HTMLButtonElement) {
        submit.disabled = false;
        if (label) label.textContent = submitLabel || 'Send message';
      }
    }
  });
</script>
