---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="empty-state surface-card">
  <p class="empty-state__title eyebrow">{title}</p>
  <div class="empty-state__body">
    <slot />
  </div>
</div>

<style>
  .empty-state {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    padding: var(--space-7);
    text-align: center;
    border-style: dashed;
  }

  .empty-state__body {
    max-width: var(--measure-prose);
    color: var(--text-secondary);
  }
</style>
