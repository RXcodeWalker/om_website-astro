---
import { site } from '../../config/site';

type SchemaType = 'Person' | 'BreadcrumbList' | 'CreativeWork';

interface BreadcrumbItem {
  name: string;
  item: string;
}

interface CreativeWorkData {
  name: string;
  description: string;
  url: string;
  datePublished?: string;
}

interface Props {
  type?: SchemaType;
  breadcrumbs?: BreadcrumbItem[];
  creativeWork?: CreativeWorkData;
}

const { type = 'Person', breadcrumbs = [], creativeWork } = Astro.props;

function defined<T extends Record<string, unknown>>(obj: T): Record<string, unknown> {
  return Object.fromEntries(
    Object.entries(obj).filter(([, value]) => value !== undefined && value !== null && value !== ''),
  );
}

function breadcrumbList(items: BreadcrumbItem[]) {
  return defined({
    '@type': 'BreadcrumbList',
    itemListElement: items.map((crumb, index) =>
      defined({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.name,
        item: crumb.item,
      }),
    ),
  });
}

function creativeWorkNode(work: CreativeWorkData) {
  return defined({
    '@type': 'CreativeWork',
    name: work.name,
    description: work.description,
    url: work.url,
    author: defined({
      '@type': 'Person',
      name: site.author,
      url: site.url,
    }),
    datePublished: work.datePublished,
  });
}

let schema: Record<string, unknown>;

if (breadcrumbs.length > 0 && creativeWork) {
  schema = {
    '@context': 'https://schema.org',
    '@graph': [breadcrumbList(breadcrumbs), creativeWorkNode(creativeWork)],
  };
} else if (type === 'BreadcrumbList') {
  schema = {
    '@context': 'https://schema.org',
    ...breadcrumbList(breadcrumbs),
  };
} else if (type === 'CreativeWork' && creativeWork) {
  schema = {
    '@context': 'https://schema.org',
    ...creativeWorkNode(creativeWork),
  };
} else {
  schema = defined({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.author,
    url: site.url,
    email: site.email,
    sameAs: site.socials.map((social) => social.href),
  });
}
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
