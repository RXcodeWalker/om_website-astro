---
import { z } from 'astro/zod';
import { metric } from '../../schemas/primitives';

interface Props {
  items?: unknown;
}

const { items } = Astro.props;

const empty = items === undefined || items === null || (Array.isArray(items) && items.length === 0);

let parsed: z.infer<typeof metric>[] = [];

if (!empty) {
  const result = z.array(metric).safeParse(items);
  if (!result.success) {
    throw new Error(`Metrics: ${result.error.message}`);
  }
  parsed = result.data;
}
---

{
  parsed.length > 0 && (
    <dl class="metrics tabular-nums">
      {parsed.map((item) => (
        <div class="metrics__item surface-card">
          <dt class="metrics__label">{item.label}</dt>
          <dd class="metrics__value">
            <span class="metrics__figure accent-text">{item.value}</span>
            {item.note && <span class="metrics__note">{item.note}</span>}
          </dd>
        </div>
      ))}
    </dl>
  )
}

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-4);
    margin: var(--space-6) 0;
  }

  .metrics__item {
    margin: 0;
    padding: var(--space-5);
    border-radius: var(--radius-xl);
  }

  .metrics__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .metrics__value {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    color: var(--text-primary);
  }

  .metrics__figure {
    display: inline-block;
    font-size: var(--step-4);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
  }

  .metrics__note {
    display: block;
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 400;
    color: var(--text-muted);
  }
</style>
