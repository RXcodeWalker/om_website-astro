---
import Icon from './Icon.astro';

type Variant = 'primary' | 'secondary' | 'quiet';
type Size = 'sm' | 'md' | 'lg';

interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: Variant;
  size?: Size;
  disabled?: boolean;
  external?: boolean;
  arrow?: boolean;
  magnetic?: boolean;
  class?: string;
  'aria-label'?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  disabled = false,
  external = false,
  arrow = false,
  magnetic = false,
  class: className = '',
  'aria-label': ariaLabel,
} = Astro.props;

const classes = ['btn', `btn--${variant}`, `btn--${size}`, external && 'btn--external', className];
const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
const magneticAttr = magnetic ? '' : undefined;
---

{
  href ? (
    <a
      href={href}
      class:list={classes}
      rel={rel}
      target={target}
      aria-disabled={disabled || undefined}
      aria-label={ariaLabel}
      data-magnetic={magneticAttr}
    >
      <slot />
      {arrow && (
        <span class="btn__arrow" aria-hidden="true">
          <Icon name={external ? 'arrow-up-right' : 'arrow-right'} />
        </span>
      )}
    </a>
  ) : (
    <button
      type={type}
      class:list={classes}
      disabled={disabled}
      aria-disabled={disabled || undefined}
      aria-label={ariaLabel}
      data-magnetic={magneticAttr}
    >
      <slot />
      {arrow && (
        <span class="btn__arrow" aria-hidden="true">
          <Icon name={external ? 'arrow-up-right' : 'arrow-right'} />
        </span>
      )}
    </button>
  )
}

<style is:global>
  .btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-inline: 20px;
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    cursor: pointer;
    transform: translate(var(--tx, 0), var(--ty, 0));
    transition: var(--dur-base) var(--ease-spring);
    transition-property: transform, background-color, border-color, box-shadow, color;
  }

  .btn--sm {
    min-height: 36px;
    padding-inline: 14px;
  }

  .btn--lg {
    min-height: 52px;
    padding-inline: 28px;
    font-size: var(--step-0);
  }

  .btn--primary {
    background: var(--accent);
    color: var(--text-on-accent);
    box-shadow: var(--shadow-1);
  }

  .btn--primary::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      115deg,
      transparent 30%,
      rgb(255 255 255 / 0.28) 50%,
      transparent 70%
    );
    transform: translateX(-120%);
    transition: transform 700ms var(--ease-spring);
  }

  .btn--secondary {
    background: var(--glass-bg-strong);
    color: var(--text-primary);
    border-color: var(--glass-border);
    box-shadow: var(--glass-highlight);
  }

  .btn--quiet {
    min-height: auto;
    padding: 0;
    overflow: visible;
    color: var(--accent);
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    border: 0;
    border-radius: 0;
    transition-property: background-size, color;
  }

  .btn__arrow {
    display: inline-flex;
    transition: transform var(--dur-base) var(--ease-spring);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn--primary:is(:hover, :focus-visible) {
      background: var(--accent-hover);
      box-shadow: var(--shadow-glow);
    }

    .btn--primary:is(:hover, :focus-visible)::before {
      transform: translateX(120%);
    }

    .btn--secondary:is(:hover, :focus-visible) {
      border-color: var(--border-strong);
      background: var(--surface-raised);
    }

    .btn--quiet:is(:hover, :focus-visible) {
      background-size: 100% 1px;
    }

    .btn:is(:hover, :focus-visible) .btn__arrow {
      transform: translateX(3px);
    }

    .btn--external:is(:hover, :focus-visible) .btn__arrow {
      transform: translate(2px, -2px);
    }
  }

  .btn[disabled],
  .btn[aria-disabled='true'] {
    opacity: 0.4;
    cursor: not-allowed;
  }

  @media (pointer: coarse) {
    .btn--sm {
      min-height: 44px;
    }

    .btn--quiet {
      min-height: 44px;
      background-size: 100% 1px;
      background-position: 0 calc(50% + 0.75em);
    }
  }
</style>
