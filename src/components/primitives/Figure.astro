---
import Media from './Media.astro';
import type { ImageMetadata } from 'astro';

type Ratio = '16:10' | '4:3' | '1:1' | '3:4' | 'free';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  number?: number;
  ratio?: Ratio;
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  caption,
  number,
  ratio = '16:10',
  eager = false,
  sizes,
  class: className = '',
} = Astro.props;
---

<figure class:list={['figure', className]}>
  <Media {src} {alt} {ratio} {eager} sizes={sizes} />
  {
    caption && (
      <figcaption class="figure__caption">
        {number !== undefined && <span class="figure__prefix">Fig. {number} — </span>}
        {caption}
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin: 0;
  }

  .figure__caption {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-muted);
    text-align: left;
  }

  .figure__prefix {
    color: var(--text-muted);
  }
</style>
