---
interface Props {
  kicker?: string;
  heading?: string;
  headingLevel?: 'h1' | 'h2' | 'h3';
  id?: string;
  index?: string;
  accent?: string;
  layout?: 'stack' | 'split';
  class?: string;
}

const {
  kicker,
  heading,
  headingLevel = 'h2',
  id,
  index,
  accent,
  layout = 'stack',
  class: className = '',
} = Astro.props;

const HeadingTag = headingLevel;
---

<section
  class:list={['section-band', `section-band--${layout}`, className]}
  aria-labelledby={heading ? id : undefined}
>
  <div class="container section-band__inner">
    <header class="section-band__head reveal">
      <div class="section-band__titles">
        {
          (index || kicker) && (
            <p class="eyebrow">
              {index && <span class="eyebrow__index">{index}</span>}
              {kicker}
            </p>
          )
        }
        {
          heading && (
            <HeadingTag id={id} class="section-band__heading">
              {heading}
              {accent && (
                <>
                  {' '}
                  <em class="accent-text">{accent}</em>
                </>
              )}
            </HeadingTag>
          )
        }
      </div>
      {
        Astro.slots.has('action') && (
          <div class="section-band__action">
            <slot name="action" />
          </div>
        )
      }
    </header>
    <div class="section-band__content">
      <slot />
    </div>
  </div>
</section>

<style is:global>
  .section-band {
    padding-block: var(--section-gap);
  }

  .section-band__inner {
    display: grid;
    gap: var(--space-7);
  }

  .section-band__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .section-band__titles {
    display: grid;
    gap: var(--space-4);
  }

  .section-band__heading {
    margin: 0;
    font-size: var(--step-4);
    max-width: 22ch;
  }

  .section-band__content {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .section-band--split .section-band__inner {
      grid-template-columns: 4fr 8fr;
      column-gap: var(--space-8);
      align-items: start;
    }

    .section-band--split .section-band__head {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
      flex-direction: column;
      align-items: start;
    }
  }
</style>
