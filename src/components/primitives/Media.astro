---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Ratio = '16:10' | '4:3' | '1:1' | '3:4' | 'free';

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: Ratio;
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  ratio = '16:10',
  eager = false,
  sizes = '(min-width: 1024px) 560px, 100vw',
  class: className = '',
} = Astro.props;

const aspectRatios: Record<Exclude<Ratio, 'free'>, string> = {
  '16:10': '16 / 10',
  '4:3': '4 / 3',
  '1:1': '1 / 1',
  '3:4': '3 / 4',
};
---

<figure
  class:list={['media', ratio !== 'free' && 'media--framed', className]}
  style={ratio !== 'free' ? `--media-ratio: ${aspectRatios[ratio]}` : undefined}
>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[480, 768, 1120, 1600]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : 'auto'}
    class="media__picture"
  />
</figure>

<style>
  .media {
    margin: 0;
    background: var(--surface-sunken);
  }

  .media--framed {
    aspect-ratio: var(--media-ratio);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
  }

  .media__picture :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media:not(.media--framed) .media__picture :global(img) {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
</style>
