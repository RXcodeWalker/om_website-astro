---
interface Props {
  class?: string;
  narrow?: boolean;
  wide?: boolean;
  dropcap?: boolean;
}

const { class: className = '', narrow = false, wide = false, dropcap = false } = Astro.props;
---

<div
  class:list={[
    'prose',
    narrow && 'prose--narrow',
    wide && 'prose--wide',
    dropcap && 'prose--dropcap',
    className,
  ]}
>
  <slot />
</div>

<style is:global>
  /* Global so slotted Markdown is styled; it still ships only on routes that render Prose. */
  .prose {
    font-size: var(--step-1);
    line-height: var(--leading-prose);
    max-width: 68ch;
    color: var(--text-primary);
    overflow-wrap: break-word;
    counter-reset: prose-h2;
  }

  .prose--narrow {
    max-width: var(--measure-narrow);
  }

  .prose--wide {
    max-width: var(--measure-wide);
  }

  .prose > * + * {
    margin-top: 1em;
  }

  .prose h2 {
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    counter-increment: prose-h2;
  }

  .prose h2::before {
    content: counter(prose-h2, decimal-leading-zero);
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-eyebrow);
    color: var(--accent);
  }

  .prose h3 {
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .prose :is(h2, h3):first-child {
    margin-top: 0;
  }

  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
    text-underline-offset: 0.15em;
    transition: var(--dur-base);
    transition-property: text-decoration-color, text-decoration-thickness;
  }

  @media (hover: hover) and (pointer: fine) {
    .prose a:hover {
      text-decoration-color: currentColor;
      text-decoration-thickness: 2px;
    }
  }

  .prose :is(ul, ol) {
    margin-block: 0;
    padding-left: var(--space-5);
  }

  .prose li + li {
    margin-top: var(--space-2);
  }

  .prose img {
    width: 100%;
    height: auto;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-sunken);
  }

  .prose blockquote {
    margin: var(--space-6) 0;
    padding-left: var(--space-5);
    border-left: 3px solid var(--highlight);
    border-radius: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-3);
    line-height: var(--leading-snug);
    color: var(--text-secondary);
  }

  .prose blockquote p {
    margin: 0;
  }

  .prose :is(code, pre) {
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .prose :not(pre) > code {
    padding: 0.1em 0.35em;
    background: var(--surface-sunken);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .prose pre {
    padding: var(--space-4);
    background: var(--surface-sunken);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow-x: auto;
  }

  .prose table {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--step-0);
  }

  .prose :is(th, td) {
    padding: var(--space-2) var(--space-3);
    text-align: left;
    border-bottom: 1px solid var(--border-subtle);
  }

  .prose--dropcap > p:first-of-type::first-letter {
    float: left;
    font-family: var(--font-display);
    font-size: 3.6em;
    line-height: 0.85;
    padding: 0.06em 0.12em 0 0;
    color: var(--highlight);
  }
</style>
