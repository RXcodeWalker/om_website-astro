---
interface Props {
  class?: string;
  narrow?: boolean;
  wide?: boolean;
}

const { class: className = '', narrow = false, wide = false } = Astro.props;
---

<div
  class:list={[
    'prose',
    narrow && 'prose--narrow',
    wide && 'prose--wide',
    className,
  ]}
>
  <slot />
</div>

<style>
  .prose--narrow {
    max-width: var(--measure-narrow);
  }

  .prose--wide {
    max-width: var(--measure-wide);
  }
</style>
