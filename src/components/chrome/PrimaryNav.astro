---
import { site } from '../../config/site';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

function isActive(href: string, external?: boolean): boolean {
  if (external) return false;
  const path = currentPath.replace(/\/+$/, '') || '/';
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}

const offset = site.nav.length;
---

<ul class="primary-nav">
  {
    site.nav.map((item, index) => (
      <li>
        <a
          href={item.href}
          class:list={['primary-nav__link', 'link-ui', item.external && 'link-external']}
          aria-current={isActive(item.href, item.external) ? 'page' : undefined}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          style={`--i: ${index}`}
        >
          {item.label}
        </a>
      </li>
    ))
  }
  {
    site.secondaryNav.map((item, index) => (
      <li>
        <a
          href={item.href}
          class:list={['primary-nav__link', 'link-ui', 'link-external']}
          target="_blank"
          rel="noopener noreferrer"
          style={`--i: ${offset + index}`}
        >
          {item.label}
        </a>
      </li>
    ))
  }
  <li class="primary-nav__indicator-item" aria-hidden="true">
    <span class="primary-nav__indicator" data-visible="false"></span>
  </li>
</ul>

<style>
  .primary-nav {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .primary-nav__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding-inline: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--step-2);
    border-radius: var(--radius-lg);
    border-bottom: 0;
    text-decoration: none;
  }

  .primary-nav__link::after {
    content: '→';
    font-family: var(--font-body);
    font-size: var(--step-0);
    color: var(--text-muted);
  }

  .primary-nav__link.link-external::after {
    content: ' ↗';
  }

  .primary-nav__link[aria-current='page'] {
    color: var(--accent);
    background: var(--wash);
    text-decoration: none;
  }

  .primary-nav__indicator-item {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.site-menu[data-open='true']) .primary-nav__link {
      animation: nav-item-in 360ms var(--ease-spring) both;
      animation-delay: calc(var(--i, 0) * 40ms + 60ms);
    }
  }

  @keyframes nav-item-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (min-width: 768px) {
    .primary-nav {
      flex-direction: row;
      align-items: center;
      gap: 2px;
      padding: 0;
    }

    .primary-nav__link,
    :global(.site-menu[data-open='true']) .primary-nav__link {
      position: relative;
      z-index: 1;
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      padding-inline: 14px;
      border-radius: var(--radius-full);
      font-family: var(--font-mono);
      font-size: var(--step--2);
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      text-decoration: none;
      animation: none;
    }

    .primary-nav__link::after {
      content: none;
    }

    .primary-nav__link.link-external::after {
      content: ' ↗';
      font-family: inherit;
      font-size: inherit;
      color: inherit;
    }

    .primary-nav__link[aria-current='page'] {
      color: var(--text-primary);
      text-decoration: none;
      background: var(--wash);
    }

    .primary-nav__link:hover,
    .primary-nav__link:focus-visible {
      text-decoration: none;
    }

    .primary-nav[data-indicator='on'] .primary-nav__link[aria-current='page'] {
      background: none;
    }

    .primary-nav__indicator-item {
      display: block;
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .primary-nav__indicator {
      position: absolute;
      top: 50%;
      left: 0;
      height: 40px;
      width: var(--ind-w, 0);
      transform: translate(var(--ind-x, 0), -50%);
      border-radius: var(--radius-full);
      background: var(--wash);
      box-shadow: inset 0 0 0 1px var(--glass-border);
      opacity: 0;
      transition:
        transform var(--dur-slower) var(--ease-spring),
        width var(--dur-slower) var(--ease-spring),
        opacity var(--dur-base);
    }

    .primary-nav__indicator[data-visible='true'] {
      opacity: 1;
    }
  }

  @media (min-width: 768px) and (pointer: coarse) {
    .primary-nav__link {
      min-height: 44px;
      padding-block: var(--space-3);
    }
  }
</style>
