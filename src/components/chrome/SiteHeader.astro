---
import { site } from '../../config/site';
import PrimaryNav from './PrimaryNav.astro';
import ThemeControls from './ThemeControls.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

{/*
  One nav, one data path. Below 768px the list is visible by default so the
  site is navigable without JavaScript; the blocking head script sets html.js,
  which is the only thing that turns the list into a disclosure menu.
*/}
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand link-ui">{site.name}</a>

    <div class="site-header__actions">
      <ThemeControls />
      <button
        type="button"
        class="menu-toggle"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span class="visually-hidden">Menu</span>
        <span class="menu-toggle__bar" aria-hidden="true"></span>
        <span class="menu-toggle__bar" aria-hidden="true"></span>
        <span class="menu-toggle__bar" aria-hidden="true"></span>
      </button>
    </div>

    <nav class="site-nav" id="site-nav" aria-label="Primary">
      <PrimaryNav {currentPath} />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--surface-raised);
    box-shadow: var(--shadow-header);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-h);
  }

  .site-header__brand {
    margin-right: auto;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    order: 2;
  }

  /* Mobile: nav occupies its own full-width row beneath the bar. */
  .site-nav {
    order: 3;
    flex-basis: 100%;
    border-top: 1px solid var(--border-subtle);
  }

  /* The toggle only exists as an enhancement. */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--border-interactive);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  :global(html.js) .menu-toggle {
    display: flex;
  }

  :global(html.js) .site-nav[data-open='false'] {
    display: none;
  }

  .menu-toggle__bar {
    display: block;
    width: 18px;
    height: 2px;
    margin-inline: auto;
    background: var(--text-primary);
  }

  @media (min-width: 768px) {
    .site-header__inner {
      flex-wrap: nowrap;
    }

    .site-header__brand {
      margin-right: 0;
    }

    .site-nav {
      order: 2;
      flex-basis: auto;
      margin-left: auto;
      border-top: 0;
    }

    .site-header__actions {
      order: 3;
    }

    :global(html.js) .menu-toggle {
      display: none;
    }

    :global(html.js) .site-nav[data-open='false'] {
      display: block;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('site-nav');

  if (toggle && nav) {
    const desktop = window.matchMedia('(min-width: 768px)');

    // Collapsed is the JS-only starting state; without this attribute the
    // list stays visible, which is the no-JS fallback.
    nav.setAttribute('data-open', 'false');

    const focusables = () =>
      Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href]')).filter(
        (el) => el.offsetParent !== null,
      );

    const setOpen = (open: boolean, restoreFocus = true) => {
      nav.setAttribute('data-open', String(open));
      toggle.setAttribute('aria-expanded', String(open));
      if (open) {
        focusables()[0]?.focus();
      } else if (restoreFocus) {
        toggle.focus();
      }
    };

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    document.addEventListener('keydown', (event) => {
      if (!isOpen() || desktop.matches) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        setOpen(false);
        return;
      }

      if (event.key !== 'Tab') return;

      // Trap focus between the toggle and the last link while the menu is open.
      const items = [toggle, ...focusables()];
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;

      if (event.shiftKey && active === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // Leaving the mobile breakpoint must not strand a collapsed nav.
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false, false);
    });
  }
</script>
