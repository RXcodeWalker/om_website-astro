---
import { site } from '../../config/site';
import PrimaryNav from './PrimaryNav.astro';
import ThemeControls from './ThemeControls.astro';
import AccentPicker from './AccentPicker.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

{/*
  One nav, one data path. Below 768px the list is visible by default so the
  site is navigable without JavaScript; the blocking head script sets html.js,
  which is the only thing that turns the list into a disclosure menu.
*/}
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand link-ui">{site.name}</a>

    <div class="site-header__actions">
      <ThemeControls />
      <button
        type="button"
        class="menu-toggle"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span class="visually-hidden">Menu</span>
        <span class="menu-toggle__bar" aria-hidden="true"></span>
        <span class="menu-toggle__bar" aria-hidden="true"></span>
        <span class="menu-toggle__bar" aria-hidden="true"></span>
      </button>
    </div>

    <div class="site-menu" id="site-menu" data-open="false">
      <nav class="site-menu__nav" aria-label="Primary">
        <PrimaryNav {currentPath} />
      </nav>
      <div class="site-menu__prefs">
        <AccentPicker />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--surface-raised);
    box-shadow: var(--shadow-header);
  }

  .site-header__inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-h);
  }

  .site-header__brand {
    margin-right: auto;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    text-decoration: none;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    order: 2;
  }

  /* Mobile: nav + prefs panel overlays the page below the bar instead of
     displacing it. */
  .site-menu {
    order: 3;
    flex-basis: 100%;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100svh - var(--header-h));
    overflow-y: auto;
    background: var(--surface-raised);
    box-shadow: var(--shadow-overlay);
    z-index: var(--z-menu);
    border-top: 1px solid var(--border-subtle);
  }

  .site-menu__prefs {
    display: flex;
  }

  @media (max-width: 767px) {
    .site-menu__prefs {
      padding: var(--space-3);
      border-top: 1px solid var(--border-subtle);
    }
  }

  /* The toggle only exists as an enhancement. */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--border-interactive);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  :global(html.js) .menu-toggle {
    display: flex;
  }

  @media (max-width: 767px) {
    :global(html.js) .site-menu[data-open='false'] {
      display: none;
    }
  }

  .menu-toggle__bar {
    display: block;
    width: 18px;
    height: 2px;
    margin-inline: auto;
    background: var(--text-primary);
  }

  @media (min-width: 768px) {
    .site-header__inner {
      flex-wrap: nowrap;
    }

    .site-header__brand {
      margin-right: 0;
      white-space: nowrap;
    }

    /* display: contents unwraps the panel so nav and prefs become direct
       flex children again — the desktop bar is byte-for-byte what it was
       before the panel wrapper existed. */
    .site-menu {
      order: 2;
      flex-basis: auto;
      margin-left: auto;
      display: contents;
    }

    .site-menu__nav {
      order: 2;
    }

    .site-menu__prefs {
      order: 3;
    }

    .site-header__actions {
      order: 4;
    }

    :global(html.js) .menu-toggle {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('site-menu');
  const header = document.querySelector('.site-header');
  const main = document.getElementById('main') as HTMLElement | null;
  const footer = document.querySelector<HTMLElement>('.site-footer');

  if (toggle && nav) {
    const desktop = window.matchMedia('(min-width: 768px)');

    // Collapsed is the JS-only starting state; without this attribute the
    // list stays visible, which is the no-JS fallback.
    nav.setAttribute('data-open', 'false');

    const focusables = () =>
      Array.from(
        nav.querySelectorAll<HTMLElement>('a[href], button, summary, [tabindex]'),
      ).filter((el) => el.offsetParent !== null);

    // inert on the rest of the page delivers focus trapping, click-through
    // prevention and AT-hiding in one attribute — no backdrop, no manual Tab
    // interception (which previously couldn't reach the toggle since it sits
    // outside #site-menu in DOM order).
    const setInert = (value: boolean) => {
      if (main) main.inert = value;
      if (footer) footer.inert = value;
    };

    const setOpen = (open: boolean, restoreFocus = true) => {
      nav.setAttribute('data-open', String(open));
      toggle.setAttribute('aria-expanded', String(open));
      if (!desktop.matches) {
        setInert(open);
        document.documentElement.classList.toggle('menu-open', open);
      }
      if (open) {
        focusables()[0]?.focus();
      } else if (restoreFocus) {
        toggle.focus();
      }
    };

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    document.addEventListener('keydown', (event) => {
      if (!isOpen() || desktop.matches) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        setOpen(false);
      }
    });

    // Outside pointerdown closes the menu.
    document.addEventListener('pointerdown', (event) => {
      if (!isOpen() || desktop.matches) return;
      if (header?.contains(event.target as Node)) return;
      setOpen(false, false);
    });

    // Leaving the mobile breakpoint must not strand a collapsed nav or inert content.
    desktop.addEventListener('change', (event) => {
      if (event.matches) {
        setInert(false);
        document.documentElement.classList.remove('menu-open');
        setOpen(false, false);
      }
    });
  }
</script>
