---
import { site } from '../../config/site';
import PrimaryNav from './PrimaryNav.astro';
import ThemeControls from './ThemeControls.astro';
import AccentPicker from './AccentPicker.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

{/*
  One nav, one data path. Below 768px the list is visible by default so the
  site is navigable without JavaScript; the blocking head script sets html.js,
  which is the only thing that turns the list into a disclosure menu.
*/}
<header class="site-header" data-scrolled="false">
  <div class="scroll-progress" aria-hidden="true"></div>
  <div class="container site-header__bar">
    <div class="site-header__pill glass">
      <a href="/" class="site-header__brand link-ui">
        <span class="brand-mark" aria-hidden="true">b</span>
        <span class="site-header__brand-text">{site.name}</span>
      </a>

      <div class="site-menu" id="site-menu" data-open="false">
        <nav class="site-menu__nav" aria-label="Primary">
          <PrimaryNav {currentPath} />
        </nav>
        <div class="site-menu__prefs">
          <p class="eyebrow site-menu__prefs-label">Accent</p>
          <AccentPicker />
        </div>
      </div>

      <div class="site-header__actions">
        <ThemeControls />
        <button
          type="button"
          class="menu-toggle"
          id="menu-toggle"
          aria-expanded="false"
          aria-controls="site-menu"
        >
          <span class="visually-hidden">Menu</span>
          <span class="menu-toggle__bar" aria-hidden="true"></span>
          <span class="menu-toggle__bar" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    padding-top: var(--space-3);
    pointer-events: none;
    view-transition-name: site-header;
  }

  .site-header__pill {
    pointer-events: auto;
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 56px;
    padding: 6px 8px 6px 16px;
    border-radius: var(--radius-full);
    transition:
      background-color var(--dur-base),
      box-shadow var(--dur-base),
      transform var(--dur-slower) var(--ease-spring);
  }

  [data-scrolled='true'] .site-header__pill {
    background: var(--glass-bg-strong);
    box-shadow: var(--glass-highlight), var(--shadow-3);
    transform: translateY(-4px);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    min-width: 0;
    margin-right: auto;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--accent), var(--highlight));
    color: var(--text-on-accent);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 20px;
    line-height: 1;
  }

  .site-header__brand-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 500;
    white-space: nowrap;
  }

  @media (max-width: 479px) {
    .site-header__pill {
      gap: var(--space-2);
      padding-left: 10px;
    }

    .site-header__brand-text {
      font-size: var(--step--1);
    }
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Reading progress, driven by the document scroll timeline. */
  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--highlight));
    transform-origin: 0 50%;
    transform: scaleX(0);
    pointer-events: none;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .scroll-progress {
        animation: progress-grow linear both;
        animation-timeline: scroll(root);
      }
    }
  }

  @keyframes progress-grow {
    to {
      transform: scaleX(1);
    }
  }

  .site-menu__prefs {
    display: flex;
    align-items: center;
  }

  .site-menu__prefs-label {
    display: none;
  }

  /* The toggle only exists as an enhancement. */
  .menu-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    color: var(--text-primary);
    cursor: pointer;
  }

  :global(html.js) .menu-toggle {
    display: flex;
  }

  .menu-toggle__bar {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: var(--radius-full);
    background: currentColor;
    transition: transform var(--dur-base) var(--ease-spring);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:first-of-type {
    transform: translateY(4px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bar:last-of-type {
    transform: translateY(-4px) rotate(-45deg);
  }

  @media (max-width: 767px) {
    /* Mobile: nav and prefs drop down as a sheet below the pill. */
    .site-menu {
      position: absolute;
      top: calc(100% + var(--space-2));
      left: 0;
      right: 0;
      z-index: var(--z-menu);
      max-height: calc(100svh - var(--header-h) - var(--space-6));
      overflow-y: auto;
      padding: var(--space-3);
      border-radius: var(--radius-xl);
      border: 1px solid var(--glass-border);
      background: var(--glass-bg-strong);
      box-shadow: var(--glass-highlight), var(--shadow-3);
      -webkit-backdrop-filter: var(--glass-blur);
      backdrop-filter: var(--glass-blur);
    }

    :global(html.js) .site-menu[data-open='false'] {
      display: none;
    }

    .site-menu__prefs {
      flex-wrap: wrap;
      gap: var(--space-3);
      margin-top: var(--space-2);
      padding: var(--space-4) var(--space-3) var(--space-2);
      border-top: 1px solid var(--glass-border);
    }

    .site-menu__prefs-label {
      display: inline-flex;
      flex-basis: 100%;
    }

    /* Without JS the header joins the flow so the visible nav never covers content. */
    :global(html:not(.js)) .site-header {
      position: relative;
    }

    :global(html:not(.js)) .site-header__pill {
      flex-wrap: wrap;
      border-radius: var(--radius-xl);
    }

    :global(html:not(.js)) .site-menu {
      position: static;
      order: 3;
      flex-basis: 100%;
      padding: 0 0 var(--space-2);
      border: 0;
      background: none;
      box-shadow: none;
    }

    /* Scrim: a pointerdown here targets <html>, outside the header, which closes the menu. */
    :global(html.menu-open)::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: var(--z-scrim);
      background: color-mix(in srgb, var(--surface-page) 55%, transparent);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-menu[data-open='true'] {
      animation: sheet-in var(--dur-base) var(--ease-spring) both;
    }
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .site-header__brand-text {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  @media (min-width: 768px) {
    .site-header__brand {
      margin-right: 0;
    }

    .site-menu {
      position: static;
      display: flex;
      flex: 1;
      align-items: center;
      justify-content: center;
      gap: var(--space-3);
      padding: 0;
      border: 0;
      background: none;
      box-shadow: none;
      animation: none;
    }

    .site-menu__prefs {
      margin-left: auto;
    }

    :global(html.js) .menu-toggle {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('site-menu');
  const header = document.querySelector('.site-header');
  const main = document.getElementById('main') as HTMLElement | null;
  const footer = document.querySelector<HTMLElement>('.site-footer');

  if (toggle && nav) {
    const desktop = window.matchMedia('(min-width: 768px)');

    // Collapsed is the JS-only starting state; without this attribute the
    // list stays visible, which is the no-JS fallback.
    nav.setAttribute('data-open', 'false');

    const focusables = () =>
      Array.from(
        nav.querySelectorAll<HTMLElement>('a[href], button, summary, [tabindex]'),
      ).filter((el) => el.offsetParent !== null);

    // inert on the rest of the page delivers focus trapping, click-through
    // prevention and AT-hiding in one attribute — no backdrop, no manual Tab
    // interception (which previously couldn't reach the toggle since it sits
    // outside #site-menu in DOM order).
    const setInert = (value: boolean) => {
      if (main) main.inert = value;
      if (footer) footer.inert = value;
    };

    const setOpen = (open: boolean, restoreFocus = true) => {
      nav.setAttribute('data-open', String(open));
      toggle.setAttribute('aria-expanded', String(open));
      if (!desktop.matches) {
        setInert(open);
        document.documentElement.classList.toggle('menu-open', open);
      }
      if (open) {
        focusables()[0]?.focus();
      } else if (restoreFocus) {
        toggle.focus();
      }
    };

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    document.addEventListener('keydown', (event) => {
      if (!isOpen() || desktop.matches) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        setOpen(false);
      }
    });

    // Outside pointerdown closes the menu.
    document.addEventListener('pointerdown', (event) => {
      if (!isOpen() || desktop.matches) return;
      if (header?.contains(event.target as Node)) return;
      setOpen(false, false);
    });

    // Leaving the mobile breakpoint must not strand a collapsed nav or inert content.
    desktop.addEventListener('change', (event) => {
      if (event.matches) {
        setInert(false);
        document.documentElement.classList.remove('menu-open');
        setOpen(false, false);
      }
    });
  }
</script>
